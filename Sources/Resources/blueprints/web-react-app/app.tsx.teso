import React from 'react';
: for module in @container.modules
: for view in module.ui-views
import { {{view.name}} } from './components/{{view.name}}';
: end-for
: end-for

export function App() {
  return (
    <main className="app">
      <h1>{{Product-name}}</h1>
: for module in @container.modules
: for view in module.ui-views
      <{{view.name}} />
: end-for
: end-for
    </main>
  );
}
