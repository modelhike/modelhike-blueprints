{{pipe_chain}}.map({{line.lambda-param}} -> {{pipe_stage}})
: end-set
: set pipe_terminal = ""
: else-if line.kind == "reduce"
: set pipe_stage = line.reduce-expression | replace(" AND ", " && ") + replace(" OR ", " || ") + replace(".length", ".size()")
: set-str pipe_chain
{{pipe_chain}}.reduce({{line.reduce-initial}}, ({{line.reduce-accumulator}}, {{line.reduce-item}}) -> {{pipe_stage}})
