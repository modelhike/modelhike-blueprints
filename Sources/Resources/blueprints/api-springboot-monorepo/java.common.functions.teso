: func renderMethod(method)
: set-str paramList
: spaceless
: if method.has-parameters
: for param in method.parameters
{{param.type | typename}}🔥{{param.name}}
: if not @loop.last
,🔥
: end-if
: end-for
: end-if
: end-spaceless
: end-set
: set-str returnTypeStr
: spaceless
: if method.has-return-type
{{method.return-type | typename}}
: else
void
: end-if
: end-spaceless
: end-set
  public {{returnTypeStr}} {{method.name}}({{paramList}}) {
