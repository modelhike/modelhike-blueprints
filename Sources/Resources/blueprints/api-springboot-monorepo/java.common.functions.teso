{{line.indent}}{{line.assign-lhs}} = {{line.assign-rhs | replace(" AND ", " && ") + replace(" OR ", " || ") + replace(".length", ".size()")}};
: end-if
: else-if line.kind == "call"
{{line.indent}}{{line.call-expression}};
: else-if line.kind == "pipe"
: set pipe_chain = line.expression
: set-str pipe_chain
{{pipe_chain}}.stream()
: end-set
: set pipe_terminal = ""
: else-if line.kind == "filter"
: set pipe_stage = line.lambda-body | replace(" AND ", " && ") + replace(" OR ", " || ") + replace(".length", ".size()")
: set-str pipe_chain
{{pipe_chain}}.filter({{line.lambda-param}} -> {{pipe_stage}})
: end-set
: set pipe_terminal = ""
: else-if line.kind == "map"
