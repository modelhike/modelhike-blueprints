{{line.chain-indent}}.map((row, rowMetadata) -> row.get("{{line.merged-db-raw-result-let}}", Integer.class)).first().block();
: else
{{line.chain-indent}}.fetch().first().block();
: end-if
: else-if line.closing-kind == "db"
{{line.indent}};
: else-if line.closing-kind in ["pipe", "filter", "select", "map", "reduce"]
// Functional pipeline stages (PIPE/FILTER/MAP/REDUCE) have no real closing
// statement -- they're rendered as a chained Stream expression when LET
// closes the chain (see below), so their close rows are intentionally silent.
: end-if
: else-if line.kind == "if"
{{line.indent}}if ({{line.condition | replace(" AND ", " && ") + replace(" OR ", " || ") + replace(".length", ".size()")}}) {
: else-if line.kind == "elseif"
{{line.indent}}} else if ({{line.condition | replace(" AND ", " && ") + replace(" OR ", " || ") + replace(".length", ".size()")}}) {
: else-if line.kind == "else"
{{line.indent}}} else {
: else-if line.kind == "for"
{{line.indent}}for (var {{line.for-item}} : {{line.for-collection}}) {
: else-if line.kind == "while"
{{line.indent}}while ({{line.condition | replace(" AND ", " && ") + replace(" OR ", " || ") + replace(".length", ".size()")}}) {
: else-if line.kind == "return"
: if line.expression
{{line.indent}}return {{line.expression | replace(" AND ", " && ") + replace(" OR ", " || ") + replace(".length", ".size()")}};
: else
{{line.indent}}return;
: end-if
: else-if line.kind == "assign"
: if line.parent-kind == "params"
: if line.assign-lhs == line.assign-rhs
{{line.indent}}.bind("{{line.assign-lhs}}", io.r2dbc.spi.Parameters.out(io.r2dbc.spi.R2dbcType.INTEGER))
: else
{{line.indent}}.bind("{{line.assign-lhs}}", {{line.assign-rhs}})
: end-if
