: func renderPlantUmlMethodSignature(method)
: set-str paramList
: spaceless
: if method.has-parameters
: for param in method.parameters
{{param.type | typename}}🔥{{param.name}}
: if not @loop.last
,🔥
: end-if
: end-for
: end-if
: end-spaceless
: end-set
: set-str returnTypeStr
: spaceless
: if method.has-return-type
{{method.return-type | typename}}
: else
void
: end-if
: end-spaceless
: end-set
 +{{method.name}}({{paramList}}) : {{returnTypeStr}}
: end-func

@startuml
:
skin rose
hide empty methods
hide circle
title {{ module.name }}
:

: for type in module.types
class {{type.name}} {
: for property in type.properties
 {{property.name}}: {{property | typename}}
: end-for
: if type.has-methods
: for method in type.methods
: call renderPlantUmlMethodSignature(method : method)
: end-for
: end-if
}

:

: end-for

:
@enduml
